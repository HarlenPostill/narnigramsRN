{
  "name": "narnigrams",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:domain": "tsx --test tests/domain/*.test.ts",
    "test:backend": "tsx --test tests/firebase/domain.test.ts",
    "test": "npm run test:domain && npm run test:backend",
    "build:functions": "npm --prefix functions run build",
    "test:emulators": "npm run build:functions && firebase emulators:exec --project demo-narnigrams --only auth,firestore,functions \"node --import tsx --test tests/firebase/emulator.test.ts\"",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-narnigrams",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:functions",
    "check:ci": "npm run check && npm run test:emulators",
    "export:web": "expo export --platform web",
    "postinstall": "patch-package",
    "web:emulator": "node scripts/web-emulator.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.19.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "firebase-tools": "^15.30.2",
    "patch-package": "8.0.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "postcss": "8.5.28",
    "brace-expansion@1": "1.1.18"
  }
}
