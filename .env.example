# Local emulator configuration only. Copy to .env.local without overwriting an existing .env.
# Firebase web app identifiers are public; Admin/service-account credentials NEVER belong here.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=narnigrams.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=narnigrams
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app-id
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=australia-southeast1

# Host only, no scheme or port. Browser/iOS simulator: 127.0.0.1.
# Physical iPhone: your development computer's LAN IP; keep the demo- project ID.
# Remove this variable entirely in preview/production Firebase configurations.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Required public HTTPS pages owned and published by the operator before App Store release.
# Blank deliberately: no privacy policy or support endpoint has been deployed by this repo.
EXPO_PUBLIC_PRIVACY_URL=https://www.narnigrams.com/privacy
EXPO_PUBLIC_SUPPORT_URL=https://www.narnigrams.com/support
