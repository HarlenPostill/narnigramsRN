rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /players/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
    match /queue/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
    match /matches/{matchId} { allow get: if signedIn() && request.auth.uid in resource.data.playerIds; allow list, write: if false; }
    match /privatePlayers/{id} { allow get: if signedIn() && resource.data.uid == request.auth.uid; allow list, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
